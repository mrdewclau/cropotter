{
  "name": "crop-ship",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p packages/engine/tsconfig.build.json",
    "assets": "node tools/engine-harness/copy-assets.mjs",
    "test:browser": "npm run assets && playwright test",
    "harness": "npm run assets && vite --config tools/engine-harness/vite.config.ts",
    "engine": "tsx tools/engine-harness/cli.ts",
    "fixtures": "tsx tools/engine-harness/generate-fixtures.ts",
    "format:check": "prettier --check \"packages/**/*.ts\" \"tools/**/*.{ts,mjs,html}\" \"*.ts\"",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "build:web": "npm run build:agents && node apps/web/scripts/copy-assets.mjs && vite build --config apps/web/vite.config.ts && node apps/web/scripts/build-server.mjs",
    "build:local": "npm run build --workspace packages/local",
    "build:agents": "npm run build:local && node tools/agent-distribution/build.mjs",
    "test:local": "npm test --workspace packages/local",
    "typecheck:local": "npm run typecheck --workspace packages/local",
    "build:claude-extension": "npm run build:local && node tools/claude-extension/build.mjs",
    "test:claude-extension": "node --test tools/claude-extension/*.test.mjs",
    "verify:claude-extension": "node tools/claude-extension/verify.mjs",
    "test:agents": "node --test tools/agent-distribution/*.test.mjs",
    "verify:agents": "node tools/agent-distribution/verify.mjs",
    "verify:local:packed": "node packages/local/scripts/verify-packed.mjs",
    "start:web": "node apps/web/dist/server/server.mjs",
    "test:web": "vitest run --config apps/web/vitest.config.ts",
    "test:web:browser": "playwright test --config apps/web/playwright.config.ts",
    "typecheck:web": "tsc --noEmit -p apps/web/tsconfig.json",
    "build:chatgpt-plugin": "npm run build:local && node tools/openai-plugin/build.mjs",
    "test:chatgpt-plugin": "npm run build:local && node --test tools/openai-plugin/*.test.mjs",
    "verify:chatgpt-submission": "node tools/openai-plugin/validate.mjs"
  },
  "devDependencies": {
    "@anthropic-ai/mcpb": "2.1.2",
    "@axe-core/playwright": "^4.11.0",
    "@napi-rs/canvas": "1.0.13",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.184.0",
    "@vitejs/plugin-react": "^6.0.2",
    "esbuild": "0.28.2",
    "prettier": "3.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "dependencies": {
    "fflate": "0.8.3",
    "ipaddr.js": "^2.2.0",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "three": "^0.184.0"
  },
  "overrides": {
    "tmp": "0.2.7"
  }
}
