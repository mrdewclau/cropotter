{
  "name": "crop-ship",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p packages/engine/tsconfig.build.json",
    "assets": "node tools/engine-harness/copy-assets.mjs",
    "test:browser": "npm run assets && playwright test",
    "harness": "npm run assets && vite --config tools/engine-harness/vite.config.ts",
    "engine": "tsx tools/engine-harness/cli.ts",
    "fixtures": "tsx tools/engine-harness/generate-fixtures.ts",
    "format:check": "prettier --check \"packages/**/*.ts\" \"tools/**/*.{ts,mjs,html}\" \"*.ts\""
  },
  "devDependencies": {
    "@napi-rs/canvas": "1.0.13",
    "@playwright/test": "1.64.1",
    "@types/node": "^24.0.0",
    "prettier": "3.8.3",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
